# ==============================================================================
# Job-Copilot v1.0.0 - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración del Proveedor LLM (Google Gemini REST)
# ------------------------------------------------------------------------------
# Llave de API oficial de Google AI Studio (requerida para extracción estructurada)
GEMINI_API_KEY="your_gemini_api_key_here"

# Modelo principal de inferencia (ej. gemini-3.5-flash-lite, gemini-2.5-flash)
GEMINI_MODEL="gemini-3.5-flash-lite"

# URL base de la API de Gemini (v1beta)
GEMINI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# Timeout en segundos para peticiones REST
REQUEST_TIMEOUT="30"

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# 2. Configuración del Motor de Scraping & Prospección (JobSpy)
# ------------------------------------------------------------------------------
# Términos de búsqueda separados por comas
SCRAPER_SEARCH_TERMS="Data Scientist, Machine Learning Engineer, Applied AI Scientist, Senior Statistician"

# Ubicaciones geográficas de prospección
SCRAPER_LOCATIONS="Colombia, Remote"

# Cantidad de vacantes deseadas por cada combinación de término/ubicación
SCRAPER_RESULTS_WANTED="5"

# Antigüedad máxima de publicación de las vacantes (en horas)
SCRAPER_HOURS_OLD="72"

# Filtrar exclusivamente ofertas 100% remotas (true / false)
SCRAPER_IS_REMOTE="false"

# Portales soportados habilitados para búsqueda (linkedin, indeed, glassdoor, zip_recruiter, google)
SCRAPER_SITES="linkedin,indeed,glassdoor,zip_recruiter,google"

# Dominio geográfico regional para Indeed (ej. colombia, mexico, us, es)
SCRAPER_COUNTRY_INDEED="colombia"

# Longitud mínima en caracteres para admitir una descripción de vacante
MIN_DESCRIPTION_LENGTH="50"

# ------------------------------------------------------------------------------
# 3. Motor de Embeddings & RAG Semántico Local
# ------------------------------------------------------------------------------
# Nombre del modelo de SentenceTransformers (descarga y ejecución local en CPU/GPU)
EMBEDDING_MODEL_NAME="paraphrase-multilingual-MiniLM-L12-v2"

# Calibración de similitud coseno: piso de ruido semántico (valores <= son ruido)
COSINE_NOISE_FLOOR="0.45"

# Calibración de similitud coseno: umbral de coincidencia fuerte
COSINE_STRONG_MATCH="0.70"

# ------------------------------------------------------------------------------
# 4. Ponderaciones y Umbrales de Calificación (Scoring)
# ------------------------------------------------------------------------------
# Puntaje mínimo global (0-100) para clasificar una vacante como 'QUALIFIED'
MIN_QUALIFIED_SCORE="60.0"

# Ponderación macro de habilidades técnicas (Hard Skills: 70%)
HARD_SKILLS_WEIGHT="0.70"

# Ponderación macro de habilidades blandas/interpersonales (Soft Skills: 30%)
SOFT_SKILLS_WEIGHT="0.30"

# Ponderación interna entre requisitos obligatorios y deseables
MANDATORY_HARD_WEIGHT="0.80"
NICE_TO_HAVE_HARD_WEIGHT="0.20"

# Gatekeeper técnico: porcentaje mínimo de hard skills obligatorias para calificar
MIN_MANDATORY_HARD_THRESHOLD="30.0"

# Multiplicador mínimo de penalización por brecha de seniority (años de experiencia)
SENIORITY_FLOOR_MULTIPLIER="0.50"

# Ponderaciones dimensionales de entidades del CV
WEIGHT_EDUCATION="2.0"
WEIGHT_LANGUAGES="1.5"
WEIGHT_INDUSTRY="1.5"
WEIGHT_HARD_SKILLS="1.0"
WEIGHT_CERTIFICATIONS="1.0"

# ------------------------------------------------------------------------------
# 5. Compilador ATS y Perfil Geográfico
# ------------------------------------------------------------------------------
# Máximo de viñetas de experiencia laboral a priorizar por cada empresa
MAX_BULLETS_PER_COMPANY="3"

# Ubicación primaria y región elegible del candidato (para gatekeeper geográfico)
CANDIDATE_PRIMARY_LOCATION="Colombia / LatAm"
